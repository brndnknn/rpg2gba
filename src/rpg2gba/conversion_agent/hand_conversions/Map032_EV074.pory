# hand conversion (2026-07-17): EV075 (Theo) is a flag-hidden actor (visibility
# flag FLAG_TEMP_16, set invisible by the map's ON_TRANSITION script) — on GBA a
# flag-hidden object is never spawned, so every applymovement targeting it in
# the transpiler's own output (event 75's walk-in and walk-out routes) was a
# no-op and Theo never appeared in-game. Base content below is copied verbatim
# from the deterministic transpiler's output
# (output/uranium-build/scripts/Map032.pory, Map032_EV074_*); the only deltas
# are addobject(75) immediately before the applymovement that reveals Theo and
# removeobject(75) immediately after his fade-out movement completes, mirroring
# the addobject/removeobject bracketing pattern in Map032_EV009.pory.

# Trainer_5
script Map032_EV074_Page1 {
    lock
    delay(18)
    msgbox(format("Hey, wait up!!!"), MSGBOX_AUTOCLOSE)
    delay(10)
    # audio (code 241): PU-Rival Theme
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    while (var(VAR_TEMP_1) < 15) {
        applymovement(OBJ_EVENT_ID_PLAYER, Map032_EV074_Page1_Move1)
        waitmovement(0)
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    }
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    while (var(VAR_TEMP_1) > 15) {
        applymovement(OBJ_EVENT_ID_PLAYER, Map032_EV074_Page1_Move2)
        waitmovement(0)
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    }
    applymovement(OBJ_EVENT_ID_PLAYER, Map032_EV074_Page1_Move3)
    # 75 (Theo) is a flag-hidden spawn (opacity=0 in RMXP, hidden via
    # FLAG_TEMP_16) — spawn him now so the walk-in choreography below has a
    # real object to target; addobject spawns regardless of the visibility
    # flag.
    addobject(75)
    applymovement(75, Map032_EV074_Page1_Move4)
    waitmovement(0)
    delay(4)
    applymovement(75, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(18)
    msgbox(format("Where do ya think you're goin', huh? Are you tryin' ta get to the lab before me so you can get the better Pokémon? Well, that ain't gonna happen! Because I'm gonna get the strongest one, first! Try to keep up, {PLAYER}!!"))
    delay(4)
    applymovement(75, Map032_EV074_Page1_Move5)
    waitmovement(0)
    # Despawn the flag-hidden scene actor now that his fade-out (Move5's
    # set_invisible) has completed. ON_TRANSITION re-hides him automatically
    # on the next map entry.
    removeobject(75)
    # audio (code 241): PU-Moki Town
    delay(10)
    setflag(FLAG_MAP032_EVENT075_SSA)
    setflag(FLAG_MAP032_EVENT074_SSA)
    release
    end
}

movement Map032_EV074_Page1_Move1 {
    walk_down
}

movement Map032_EV074_Page1_Move2 {
    walk_up
}

movement Map032_EV074_Page1_Move3 {
    face_right
}

movement Map032_EV074_Page1_Move4 {
    set_visible
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
}

movement Map032_EV074_Page1_Move5 {
    walk_up
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    set_invisible
}

# Trainer_5
script Map032_EV074_Page2 {
    end
}

# Trainer_5
script Map032_EV074_Page3 {
    end
}
