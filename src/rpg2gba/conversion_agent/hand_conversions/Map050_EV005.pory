# hand conversion (2026-07-17): the aptitude-test scoring chain is novel
# embedded Ruby the transpiler can't interpret (SLICE1_TODO #17): an ARRAY
# stored in game variable 151 (`$game_variables[151]=[0,0,0]`), per-answer
# tally `pbGet(151)[pbGet(2)]+=1`, argmax + 0<->1 swap, and the
# pbStarterSelector fullscreen cutscene (presentation-only in Uranium —
# 230_StarterSelect.rb; the real grant is EV019's pbAddPokemon). Base content
# is verbatim transpiler output (output/uranium-build/scripts/Map050.pory);
# deltas: SSB retake jump implemented as goto(TestBody); tally array -> the
# scene-local scratch vars VAR_TEMP_3/4/5 (scene never changes maps, temps
# safe; VAR_TEMP_0/1 = transpiler scratch, VAR_TEMP_C/F reserved); argmax as
# explicit compares; selector cutscene -> result announcement msgbox with the
# Emerald stand-in starter names (user decision 2026-07-17, Phase-7 debt:
# Orchynx->TREECKO, Raptorch->TORCHIC, Eletux->MUDKIP).

script Map050_EV005_Page1 {
    lockall
    if (flag(FLAG_MAP050_EVENT005_SSB)) {
        # RMXP 119 jump-to-label: SSB is the retake path (set by Page3's
        # re-offer) — skip the intro, straight into the test.
        goto(Map050_EV005_TestBody)
    }
    # audio (code 241): PU-Radio_ Oak
    applymovement(OBJ_EVENT_ID_PLAYER, Map050_EV005_Page1_Move1)
    waitmovement(0)
    delay(10)
    msgbox(format("Bamb'o: Hey, if it isn't {PLAYER}! And uh, your friend... Tommy, was it?"))
    delay(5)
    msgbox(format("Honestly, pops, can't you even remember my name? It's Theo! Theo!!"))
    msgbox(format("Right, right... Theo. You're just in time. Today is a very special day for both of you. It's your first day at work as Field Research Assistants at Bamb'o Pokémon Research Labs."))
    msgbox(format("Your job will have you traveling across Tandor, observing and capturing many different kinds of Pokémon to help me with my research on Pokémon Elements."))
    msgbox(format("I have three Pokémon here that will aid you on your journey."))
    msgbox(format("Before you get your starters, though, you both will take the <b>Pokémon Trainer Aptitude Test</b>."))
    delay(10)
    applymovement(20, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(16)
    msgbox(format("Test?! I didn't study for any test! I thought you were gonna give us a rare, powerful Pokémon!"))
    msgbox(format("Now, now, don't worry... It's not the kind of test you have to study for. It's just a way to determine what kind of Pokémon Trainer you will be. Different starter Pokémon are better suited for different battling styles. A starter Pokémon will be your lifelong partner, so it's important for you to work well together!"))
    msgbox(format("Yeah, yeah, I get it. Enough talking! I want to get my Pokémon!"))
    msgbox(format("Sheesh, kid, you're not very patient, are you?"))
    msgbox(format("All right."))
    msgbox(format("If you want to know more about what's on the test before we begin, you can talk to my Aide."))
    msgbox(format("Now..."))
    # audio (code 241): PU-Radio_ Oak
    msgbox(format("{PLAYER}, are you ready to take the <b>Trainer Aptitude Test</b>?"))
    yesnobox(0, 0)
    if (var(VAR_RESULT) == 1) {
        goto(Map050_EV005_TestBody)
    } else {
        msgbox(format("That's all right. Take your time."))
        applymovement(20, Map050_EV005_Page1_Move3)
        waitmovement(0)
        delay(8)
        msgbox(format("Yeah, but not too long, all right?"))
        delay(8)
        applymovement(20, Map050_EV005_Page1_Move4)
        waitmovement(0)
        setflag(FLAG_MAP050_EVENT005_SSD)
    }
    fadedefaultbgm
    # audio (code 241): PU-Lab
    releaseall
    end
}

movement Map050_EV005_Page1_Move1 {
    delay_4
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
}

movement Map050_EV005_Page1_Move2 {
    walk_right
    face_left
}

movement Map050_EV005_Page1_Move3 {
    face_right
}

movement Map050_EV005_Page1_Move4 {
    face_up
}

text Map050_EV005_Page1_Choice1_Opt0 {
    format("Attack it right away!")
}

text Map050_EV005_Page1_Choice1_Opt1 {
    format("Wait and see what it does.")
}

text Map050_EV005_Page1_Choice1_Opt2 {
    format("Throw a Poké Ball at it!")
}

text Map050_EV005_Page1_Choice2_Opt0 {
    format("Hyper Beam")
}

text Map050_EV005_Page1_Choice2_Opt1 {
    format("Protect")
}

text Map050_EV005_Page1_Choice2_Opt2 {
    format("Hidden Power")
}

text Map050_EV005_Page1_Choice3_Opt0 {
    format("Gyarados")
}

text Map050_EV005_Page1_Choice3_Opt1 {
    format("Gliscor")
}

text Map050_EV005_Page1_Choice3_Opt2 {
    format("Ampharos")
}

text Map050_EV005_Page1_Choice4_Opt0 {
    format("Becoming the very best")
}

text Map050_EV005_Page1_Choice4_Opt1 {
    format("Exploring the region")
}

