    format("Making new friends")
}

# Bambo
script Map050_EV005_Page2 {
    lock
    faceplayer
    msgbox(format("Go ahead and take it, {PLAYER}."))
    release
    end
}

# Bambo
script Map050_EV005_Page3 {
    lock
    faceplayer
    msgbox(format("{PLAYER}, are you ready to take the <b>Trainer Aptitude Test</b>?"))
    yesnobox(0, 0)
    if (var(VAR_RESULT) == 1) {
        delay(8)
        # UNHANDLED code 111: conditional on character-facing — branch (4 then / 1 else nodes) not emitted
        applymovement(OBJ_EVENT_ID_PLAYER, Map050_EV005_Page3_Move1)
        waitmovement(0)
        delay(8)
        setflag(FLAG_MAP050_EVENT005_SSB)
        clearflag(FLAG_MAP050_EVENT005_SSD)
    } else {
        msgbox(format("That's all right. Take your time."))
        applymovement(20, Map050_EV005_Page3_Move2)
        waitmovement(0)
        delay(8)
        msgbox(format("Yeah, but not too long, all right?"))
        delay(8)
        applymovement(20, Map050_EV005_Page3_Move3)
        waitmovement(0)
    }
    release
    end
}

movement Map050_EV005_Page3_Move1 {
    walk_down
    face_up
}

movement Map050_EV005_Page3_Move2 {
    face_right
}

movement Map050_EV005_Page3_Move3 {
    face_up
}

