    end
}

# Bambo
script Map050_EV005_Page8 {
    lock
    faceplayer
    msgbox(format("I can only honor you so much... But I heard that there are some enthusiasts in Bealbeach City who would love it if you showed them your completed Pokedéx."))
    msgbox(format("Unfortunately, I also heard they aren't currently receiving visitors."))
    release
    end
}

# The test proper: entered from the yes-arm AND from the SSB retake
# jump (RMXP label at the top of the original yes-branch).
script Map050_EV005_TestBody {
    # (RMXP label 118 sat here — TestBody's entry point IS the label.)
    delay(4)
    # '$game_variables[151]=[0,0,0]' — zero the three tally buckets.
    setvar(VAR_TEMP_3, 0)
    setvar(VAR_TEMP_4, 0)
    setvar(VAR_TEMP_5, 0)
    msgbox(format("Excellent! So, without further ado..."))
    msgbox(format("When you encounter a new kind of Pokémon in the wild, what is your first reaction?"))
    dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE, Map050_EV005_Page1_Choice1_Opt0, Map050_EV005_Page1_Choice1_Opt1, Map050_EV005_Page1_Choice1_Opt2)
    copyvar(VAR_TEMP_MOVE_CHOICE, VAR_RESULT)
    call(Map050_EV005_Tally)
    delay(8)
    msgbox(format("Very good, both of you."))
    msgbox(format("C'mon, that was easy! Give me a tougher one!"))
    msgbox(format("Okay... next question, then."))
    msgbox(format("Which of these TMs would you prefer to teach to your Pokémon?"))
    dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE, Map050_EV005_Page1_Choice2_Opt0, Map050_EV005_Page1_Choice2_Opt1, Map050_EV005_Page1_Choice2_Opt2)
    copyvar(VAR_TEMP_MOVE_CHOICE, VAR_RESULT)
    call(Map050_EV005_Tally)
    delay(8)
    msgbox(format("Hey, professor... What's a TM, anyway?"))
    msgbox(format("Um... I'll tell you later. Let's move on with the next question, shall we?"))
    msgbox(format("Which of the following Pokémon would win in an all-out battle?"))
    dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE, Map050_EV005_Page1_Choice3_Opt0, Map050_EV005_Page1_Choice3_Opt1, Map050_EV005_Page1_Choice3_Opt2)
    copyvar(VAR_TEMP_MOVE_CHOICE, VAR_RESULT)
    call(Map050_EV005_Tally)
    delay(8)
    msgbox(format("Is it possible to fail this test?"))
    msgbox(format("No, it isn't. Now, this is your final question, so answer it honestly!"))
    msgbox(format("What is your motivation for becoming a Pokémon Trainer?"))
    dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE, Map050_EV005_Page1_Choice4_Opt0, Map050_EV005_Page1_Choice4_Opt1, Map050_EV005_Page1_Choice4_Opt2)
    copyvar(VAR_TEMP_MOVE_CHOICE, VAR_RESULT)
    call(Map050_EV005_Tally)
    delay(8)
    msgbox(format("No question about it! I'm gonna be a Pokémon Master! An' nobody's gonna stand in my way!"))
    msgbox(format("Haha... I dig your spirit, kid! Well, that's it for the <b>Trainer Aptitude test</b>."))
    msgbox(format("Now it's time to analyze your results.{PAUSE 0x0F}.{PAUSE 0x0F}."), MSGBOX_AUTOCLOSE)
    msgbox(format(".{PAUSE 0x24}.{PAUSE 0x24}."), MSGBOX_AUTOCLOSE)
    msgbox(format("Okay, I finished my analysis!"))
    delay(10)
    fadescreen(FADE_TO_BLACK)
    delay(26)
    # x = tally.index(tally.max) (Ruby ties -> lowest index), then the
    # original's 0<->1 swap; stored 0-based in VAR_POKEMONTEST
    # (0=Orchynx-line, 1=Raptorch-line, 2=Eletux-line). The accept path
    # below adds +1 to make it 1-based for EV019, exactly like the RMXP
    # event. pbStarterSelector's fullscreen reveal is replaced by the
    # announcement msgbox after the fade below.
    #
    # Poryscript can't compare two vars directly, so "A >= B" is done as
    # u16 subtract-and-test-sign: subvar's second operand goes through
    # VarGet, so a VAR_* id dereferences; A-B wraps past 0x8000 iff B > A.
    # raw2 default; raw1 (T4>=T5, T4>T3 implied by the later overwrite) ->
    # swapped 0; raw0 (T3>=T4 && T3>=T5) overwrites -> swapped 1.
    setvar(VAR_POKEMONTEST, 2)
    copyvar(VAR_RESULT, VAR_TEMP_4)
    subvar(VAR_RESULT, VAR_TEMP_5)
    if (var(VAR_RESULT) < 32768) {
        setvar(VAR_POKEMONTEST, 0)
    }
    copyvar(VAR_RESULT, VAR_TEMP_3)
    subvar(VAR_RESULT, VAR_TEMP_4)
    if (var(VAR_RESULT) < 32768) {
        copyvar(VAR_RESULT, VAR_TEMP_3)
        subvar(VAR_RESULT, VAR_TEMP_5)
        if (var(VAR_RESULT) < 32768) {
            setvar(VAR_POKEMONTEST, 1)
        }
    }
    delay(10)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    # pbStarterSelector reveal, as dialogue (stand-in names, Phase-7 debt):
    if (var(VAR_POKEMONTEST) == 0) {
        msgbox(format("Based on your results, the partner best suited to you is TREECKO!"))
    } elif (var(VAR_POKEMONTEST) == 1) {
        msgbox(format("Based on your results, the partner best suited to you is TORCHIC!"))
    } else {
        msgbox(format("Based on your results, the partner best suited to you is MUDKIP!"))
    }
    # dropped 209 route (target 19, codes [44,15,41,15,41]): machine SE +
    # ball-graphic swap — cosmetic, no native per-frame gfx swap (gap #6).
    delay(10)
    applymovement(5, Map050_EV005_Page1_Move2)
    waitmovement(0)
    msgbox(format("Go ahead and take it, {PLAYER}."))
    setflag(FLAG_MAP050_EVENT005_SSC)
    addvar(VAR_POKEMONTEST, 1)
    end
}

# `pbGet(151)[pbGet(2)]+=1` — bump the tally bucket picked by the last
# dynmultichoice answer (0-based, via VAR_TEMP_MOVE_CHOICE).
script Map050_EV005_Tally {
    switch (var(VAR_TEMP_MOVE_CHOICE)) {
        case 0:
            addvar(VAR_TEMP_3, 1)
        case 1:
            addvar(VAR_TEMP_4, 1)
        case 2:
            addvar(VAR_TEMP_5, 1)
    }
    return
}
