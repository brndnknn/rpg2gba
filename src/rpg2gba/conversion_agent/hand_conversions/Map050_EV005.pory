# Bambo
script Map050_EV005_Page6 {
    lock
    faceplayer
    # phone: pbPhoneRegisterNPC stripped (slice1)
    msgbox(format("Ah, hello {PLAYER}. Are you here to evaluate your PokéDex?"))
    msgbox(format("I'll reward you for reaching certain milestones in your collection."))
    yesnobox(0, 0)
    if (var(VAR_RESULT) == 1) {
        # UNHANDLED code 355: script call: 'pbSet(1,PROFREWARDS[pbGet(22)+1][0])'
        # UNHANDLED code 355: script call: 'pbSet(2,$Trainer.pokedexSeen)'
        # UNHANDLED code 355: script call: 'pbSet(3,$Trainer.pokedexOwned)'
        # UNHANDLED code 101: dialogue with untranslated control code: "Hmmm\\wt[8].\\wt[8].\\wt[8].\\wt[15]So, you've seen \\r\\v[2]\\c[0] Pokémon\\nand caught \\r\\v[3]\\c[0] of them..."
        # UNHANDLED code 111: conditional on script: jvNextReward — branch (12 then / 3 else nodes) not emitted
    } else {
        msgbox(format("No? Ah well, then... Until next time!"))
    }
    release
    end
}

