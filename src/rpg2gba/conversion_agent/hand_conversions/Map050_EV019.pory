# hand conversion (2026-07-17, species updated 2026-07-18): the starter
# grant + Theo counter-pick are novel embedded Ruby (SLICE1_TODO #17). Base
# content is verbatim transpiler output; deltas: pbAddPokemon per 1-based
# VAR_POKEMONTEST -> givemon with the real starter species (SPECIES_ORCHYNX/
# RAPTORCH/ELETUX) + HAS-starter flags; Theo's counter-pick (x=var151-2,
# wrap -1->2; pbStarterSelector(x,true) is presentation-only) -> announcement
# msgbox. The randomizer-mode branches and the rival battle are NOT
# converted (see comments in place).

script Map050_EV019_Page1 {
    lock
    faceplayer
    # UNHANDLED code 209: move route (target 19, 1 steps, codes [41]) outside the deterministic tier — paired 210 waits are neutralized
    # randomizer-mode branch ($PokemonGlobal.randomizer) not converted —
    # normal path only. Grant per 1-based VAR_POKEMONTEST:
    switch (var(VAR_POKEMONTEST)) {
        case 1:
            givemon(SPECIES_ORCHYNX, 5)
            setflag(FLAG_HAS_ORCHYNX)
            msgbox(format("{PLAYER} received Orchynx!"))
        case 2:
            givemon(SPECIES_RAPTORCH, 5)
            setflag(FLAG_HAS_RAPTORCH)
            msgbox(format("{PLAYER} received Raptorch!"))
        case 3:
            givemon(SPECIES_ELETUX, 5)
            setflag(FLAG_HAS_ELETUX)
            msgbox(format("{PLAYER} received Eletux!"))
        default:
            # W8 fix B (2026-07-19): VAR_POKEMONTEST is 0 until the aptitude
            # test finishes. Without this arm the switch matched nothing and
            # FELL THROUGH into the whole Theo cutscene below — bumping
            # VAR_QUEST_LOG and setting FLAG_RECEIVED_STARTER with no starter
            # granted (sequence break). Early-out instead. Text is invented
            # (RMXP's pre-test page had no interaction); review at boot gate.
            msgbox(format("The machine hums softly. Three Poké Balls rest inside."))
            release
            end
    }
    # W9 fix (2026-07-20): givemon (-> ScrCmd_createmon) adds the starter to
    # gPlayerParty but never sets FLAG_SYS_POKEMON_GET, which the START-menu
    # POKEMON option is gated on (engine/src/start_menu.c:340,359; the only
    # setter, SetDexPokemonPokenavFlags, is // unused). Essentials' party menu
    # is always available; Emerald gates it on this flag. Without it the mon is
    # in the party but invisible (no menu slot) -> user saw "received X!" with
    # no party. Reached only on the grant path (the default arm ends above).
    setflag(FLAG_SYS_POKEMON_GET)
    delay(20)
    # audio (code 241): PU-Rival Theme
    applymovement(OBJ_EVENT_ID_PLAYER, Map050_EV019_Page1_Move1)
    applymovement(5, Map050_EV019_Page1_Move2)
    applymovement(20, Map050_EV019_Page1_Move3)
    waitmovement(0)
    delay(10)
    msgbox(format("HEY! I'M TIRED OF WAITING!"))
    # UNHANDLED code 209: move route (target 20, 6 steps, codes [44, 14, 15, 44, 14, 15]) outside the deterministic tier — paired 210 waits are neutralized
    msgbox(format("{PLAYER} got their starter already! When do I get mine?"))
    msgbox(format("I'm done analyzing your results, Theo."))
    msgbox(format("Hmm{PAUSE 0x18}.{PAUSE 0x18}.{PAUSE 0x18}."), MSGBOX_AUTOCLOSE)
    fadescreen(FADE_TO_BLACK)
    delay(26)
    # Theo's counter-pick: x = var151 - 2, wrap -1 -> 2 (rock-paper-
    # scissors counter of the player's line); pbStarterSelector(x,true) is
    # the presentation cutscene — announced after the fade instead.
    delay(10)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    switch (var(VAR_POKEMONTEST)) {
        case 1:
            msgbox(format("Theo received Eletux!"))
        case 2:
            msgbox(format("Theo received Orchynx!"))
        case 3:
            msgbox(format("Theo received Raptorch!"))
    }
    msgbox(format("Yes!! My first Pokémon!"))
    applymovement(20, Map050_EV019_Page1_Move4)
    applymovement(20, Map050_EV019_Page1_Move5)
    applymovement(OBJ_EVENT_ID_PLAYER, Map050_EV019_Page1_Move6)
    waitmovement(0)
    # UNHANDLED code 209: move route (target 19, 1 steps, codes [41]) outside the deterministic tier — paired 210 waits are neutralized
    delay(20)
    # UNHANDLED code 111: conditional on script: $PokemonGlobal.randomizer — branch (6 then / 0 else nodes) not emitted
    applymovement(20, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(20)
    applymovement(20, Map050_EV019_Page1_Move7)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Map050_EV019_Page1_Move8)
    waitmovement(0)
    delay(10)
    msgbox(format("{PLAYER}... you have a Pokémon. And now I have a Pokémon, too. You know what this means, right? We hafta battle!"))
    msgbox(format("Oh, please, not in the Lab..."))
    delay(10)
    # Rival battle (2026-07-21): the RMXP source ran
    #   pbTrainerBattle(RIVAL,"Theo",...,party=pbGet(151)+18,canlose)
    # inside a code-111 win/lose branch (the 66/55-node aftermath the earlier
    # stub dropped). Mapped to trainerbattle_earlyrival + RIVAL_BATTLE_HEAL_AFTER
    # — the earlyrival mode: you CAN lose (no white-out), the party auto-heals
    # afterward (covers Uranium's "I'll heal your Pokémon" beat), the trainer's
    # win/lose reaction text is shown by the battle system, VAR_RESULT records
    # the outcome (read below), and the scene converges either way (both RMXP
    # branches also converge to the prof's Route-01 farewell + VAR_QUEST_LOG
    # bump). NOTE: do NOT use RIVAL_BATTLE_TUTORIAL here — that flag adds
    # BATTLE_TYPE_FIRST_BATTLE (battle_setup.c:1322), the Birch-intro tutorial
    # type where the opponent is framed as WILD and FLEES at low HP, so the
    # player can never actually lose. HEAL_AFTER is the plain losable+heal mode.
    # Party by starter line: 1 Orchynx -> Theo Eletux (THEO_9); 2 Raptorch ->
    # Theo Orchynx (THEO_10); 3 Eletux -> Theo Raptorch (THEO_11).
    switch (var(VAR_POKEMONTEST)) {
        case 1:
            trainerbattle_earlyrival(TRAINER_THEO_9, RIVAL_BATTLE_HEAL_AFTER, Map050_EV019_Theo_DefeatText, Map050_EV019_Theo_VictoryText)
        case 2:
            trainerbattle_earlyrival(TRAINER_THEO_10, RIVAL_BATTLE_HEAL_AFTER, Map050_EV019_Theo_DefeatText, Map050_EV019_Theo_VictoryText)
        case 3:
            trainerbattle_earlyrival(TRAINER_THEO_11, RIVAL_BATTLE_HEAL_AFTER, Map050_EV019_Theo_DefeatText, Map050_EV019_Theo_VictoryText)
    }
    # Record the outcome for Theo's dad scene (Map172 EV004 branches on it).
    # The earlyrival converge dropped the RMXP win/lose branches that used to
    # write Uranium switch 35 = FLAG_LOST_FIRST_BATTLE (ON iff the player LOST).
    # The engine sets VAR_RESULT = TRUE when the player was defeated in an
    # EARLY_RIVAL battle (battle_setup.c). Reproduce switch 35 here, before any
    # msgbox/yesno can clobber VAR_RESULT.
    if (var(VAR_RESULT) == 1) {
        setflag(FLAG_LOST_FIRST_BATTLE)
    } else {
        clearflag(FLAG_LOST_FIRST_BATTLE)
    }
    delay(20)
    # Theo leaves the lab. His walk-off lived inside the un-emitted battle
    # branch, which is why his sprite used to strand next to the machine; drive
    # him to the door and vanish before the prof's farewell.
    applymovement(20, Map050_EV019_Theo_Exit)
    waitmovement(0)
    delay(10)
    applymovement(5, Map050_EV019_Page1_Move9)
    waitmovement(0)
    delay(10)
    msgbox(format("I'm going out to the entrance to Route 01 by the edge of town. Bring Theo, and I'll teach you both how to catch Pokémon."))
    msgbox(format("See you later, {PLAYER}."))
    delay(10)
    applymovement(5, Map050_EV019_Page1_Move10)
    waitmovement(0)
    addvar(VAR_QUEST_LOG, 1)
    setflag(FLAG_RECEIVED_STARTER)
    release
    end
}

movement Map050_EV019_Page1_Move1 {
    face_down
}

movement Map050_EV019_Page1_Move2 {
    face_down
}

movement Map050_EV019_Page1_Move3 {
    walk_right
    face_up
}

movement Map050_EV019_Page1_Move4 {
    walk_up
}

movement Map050_EV019_Page1_Move5 {
    walk_up
}

movement Map050_EV019_Page1_Move6 {
    walk_left
    walk_down
    walk_down
    face_up
}

movement Map050_EV019_Page1_Move7 {
    walk_down
    walk_down
    face_left
}

movement Map050_EV019_Page1_Move8 {
    face_right
}

movement Map050_EV019_Page1_Move9 {
    walk_down
    walk_down
    walk_down
    walk_down
    face_up
}

movement Map050_EV019_Page1_Move10 {
    walk_down
    walk_down
    walk_down
    walk_down
    set_invisible
}

# Rival-battle actor exit + reaction text (2026-07-21).
movement Map050_EV019_Theo_Exit {
    walk_down
    walk_down
    walk_down
    walk_down
    set_invisible
}

# Shown when Theo LOSES (player wins) — RMXP win-branch reaction.
text Map050_EV019_Theo_DefeatText {
    format("B-but... How...\pI'm s'posed to be the b-best trainer ever...")
}

# Shown when Theo WINS (player loses) — RMXP lose-branch reaction.
text Map050_EV019_Theo_VictoryText {
    format("Yes!! My first win! My Pokémon an' me are gonna be the best, coolest team in Tandor! I gotta go show dad!")
}

# Machine
script Map050_EV019_Page2 {
    end
}

# Machine
script Map050_EV019_Page3 {
    end
}
