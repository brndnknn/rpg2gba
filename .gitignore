engine/include/constants/rpg2gba_event_objects.gen.h
engine/src/data/object_events/rpg2gba_*.gen.h
engine/graphics/object_events/pics/uranium/
# PokePod phone rematches (S8b5): generated engine fragments, pulled in by committed
