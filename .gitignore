# Verbatim Uranium source extracted by recon scripts. Per CLAUDE.md, never commit.
# Summaries (reference/*.md) are derived and OK to track; raw dumps are not.
reference/scripts_dump/
reference/maps_dump/
reference/dat_dump/
# Generated real-art tile-map overlay (S8a); load_tile_map prefers it over the
# committed tileset_map.json. Regenerated each assembly; never committed.
reference/tileset_map.gen.json
# Per-map viewer feedback punch-lists. Transient review scratch — a flag exists
# only until the build agent fixes it, so there's no value in versioning them.
reference/map_feedback/

# Vendored engine (pokeemerald-expansion in engine/). Its own .gitignore keeps
# build/ + *.gba out. Below are rpg2gba PIPELINE-generated artifacts the assembler
# writes INTO the engine tree — regenerated, never committed. A general convention
# for ALL Uranium maps is a BUILD_PLAN follow-up; the pathfinder slice paths are
# listed explicitly for now. The assembler NO LONGER edits tracked upstream files in
# place: data/event_scripts.s + map_data_rules.mk carry committed, stable include-hooks
# and all per-slice content lands in the generated *.gen.json / *.inc files below.
# See engine/RPG2GBA_VENDOR.md.
engine/data/scripts/CommonEvents.inc
engine/data/scripts/rpg2gba_flags.h
engine/data/scripts/rpg2gba_map_aliases.h
engine/data/scripts/Map*_dispatch.pory
engine/data/maps/rpg2gba_includes.inc
engine/data/maps/map_groups.gen.json
engine/data/layouts/layouts.gen.json
# S8b4: encounter-table overlay (picked up by the RPG2GBA_WILD_ENCOUNTERS hook
# in engine/Makefile; absent => the committed wild_encounters.json is used).
engine/src/data/wild_encounters.gen.json
# White-out heal locations overlay (picked up by the RPG2GBA_HEAL_LOCATIONS hook
# in engine/json_data_rules.mk; absent => the committed heal_locations.json is used).
engine/src/data/heal_locations.gen.json
# Region-map sections overlay (picked up by the RPG2GBA_REGION_MAP_SECTIONS hook
# in engine/json_data_rules.mk; absent => the committed region_map_sections.json is used).
engine/src/data/region_map/region_map_sections.gen.json
# S8d: pre-planted berry-tree seed table (pulled in by the committed RPG2GBA
# GAME PROFILE include-hook right after ClearBerryTrees() in src/new_game.c).
engine/data/scripts/rpg2gba_berry_trees.h
# The game's phone name in the Match Call registration line (game_profile.header; included
# by event_scripts.s under RPG2GBA_PHONE_TEXT_INC).
engine/data/scripts/rpg2gba_phone_text.inc
# S8a tileset graphics: generated engine fragments (pulled in by committed sentinel
# #include hooks in src/data/tilesets/*.h + include/tilesets.h) and the emitted art.
engine/src/data/tilesets/rpg2gba_graphics.gen.h
engine/src/data/tilesets/rpg2gba_metatiles.gen.h
engine/src/data/tilesets/rpg2gba_tilesets.gen.h
# Tileset animations: gen'd frame tables + callbacks, pulled in by the committed
